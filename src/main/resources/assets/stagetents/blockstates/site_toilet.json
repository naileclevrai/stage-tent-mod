{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "open": "false"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet"
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "false"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "false"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "false"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "open": "true"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet_open"
      }
    },
    {
      "when": {
        "facing": "east",
        "open": "true"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet_open",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "open": "true"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet_open",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "open": "true"
      },
      "apply": {
        "model": "stagetents:block/props/site_toilet_open",
        "y": 270
      }
    }
  ]
}
