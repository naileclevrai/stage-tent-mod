{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "right": "false"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher_end_right"
      }
    },
    {
      "when": {
        "facing": "east",
        "right": "false"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher_end_right",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "right": "false"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher_end_right",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "right": "false"
      },
      "apply": {
        "model": "stagetents:block/props/bleacher_end_right",
        "y": 270
      }
    }
  ]
}
