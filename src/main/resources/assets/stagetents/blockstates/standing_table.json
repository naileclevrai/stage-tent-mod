{
  "multipart": [
    {
      "when": {
        "cover": "true"
      },
      "apply": {
        "model": "stagetents:block/props/standing_table"
      }
    },
    {
      "when": {
        "cover": "false"
      },
      "apply": {
        "model": "stagetents:block/props/standing_table_bare"
      }
    }
  ]
}
