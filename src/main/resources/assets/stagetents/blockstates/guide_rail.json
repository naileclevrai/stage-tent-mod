{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "corner": "false"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail"
      }
    },
    {
      "when": {
        "facing": "east",
        "corner": "false"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "corner": "false"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "corner": "false"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "corner": "true"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail_corner"
      }
    },
    {
      "when": {
        "facing": "east",
        "corner": "true"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail_corner",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "corner": "true"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail_corner",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "corner": "true"
      },
      "apply": {
        "model": "stagetents:block/props/guide_rail_corner",
        "y": 270
      }
    }
  ]
}
