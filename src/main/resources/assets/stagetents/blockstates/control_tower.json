{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "stagetents:block/control_tower" } },
    { "when": { "facing": "east" }, "apply": { "model": "stagetents:block/control_tower", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "stagetents:block/control_tower", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "stagetents:block/control_tower", "y": 270 } }
  ]
}
