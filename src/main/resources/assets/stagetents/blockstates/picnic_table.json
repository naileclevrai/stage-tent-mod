{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "parasol": "false"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table"
      }
    },
    {
      "when": {
        "facing": "east",
        "parasol": "false"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "parasol": "false"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "parasol": "false"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "parasol": "true"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table_parasol"
      }
    },
    {
      "when": {
        "facing": "east",
        "parasol": "true"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table_parasol",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "parasol": "true"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table_parasol",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "parasol": "true"
      },
      "apply": {
        "model": "stagetents:block/props/picnic_table_parasol",
        "y": 270
      }
    }
  ]
}
